{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roco Database",
  "version": "0.1.0",
  "identifier": "com.sans.rocodatebase",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build; powershell -ExecutionPolicy Bypass -File ../scripts/prepare-python-runtime.ps1",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "Roco Database",
        "width": 566,
        "height": 640,
        "minWidth": 283,
        "minHeight": 320
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/rocodatebase", "resources/python"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
